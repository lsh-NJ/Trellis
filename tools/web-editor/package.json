{
  "name": "trellis-web-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Trellis 知识库的 WebView 段落式编辑器源码（Tiptap 3 + ProseMirror）。构建产物写到 app/ui/src/jvmMain/resources/editor/editor.js。",
  "type": "module",
  "scripts": {
    "build": "node scripts/embed-katex.mjs && esbuild src/main.js --bundle --minify --format=iife --target=es2017 --outfile=../../app/ui/src/jvmMain/resources/editor/editor.js",
    "build:spike": "esbuild src/main.js --bundle --format=iife --target=es2017 --outfile=build/editor.js"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-code-block-lowlight": "^3.34.0",
    "@tiptap/extension-mathematics": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "lowlight": "^3.3.0",
    "marked": "^15.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
